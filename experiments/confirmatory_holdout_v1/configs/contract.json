  ],
  "controls": {
    "CTRL_identity": {
      "description": "Exact re-evaluation of unchanged events and grid.",
      "scoped_families": ["timing", "density", "grammar", "structure"],
      "metrics": ["timing.clean_rate", "timing.absolute_error_p99_ms", "timing.grid_phase_offset_abs_ms", "density_adequacy_score", "density_spike_score", "transition_validity_score", "repetition_adequacy_score", "surface_variety_adequacy_score", "pattern_ic_adequacy_score", "pattern_nll"]
    },
    "CTRL_joint_time_origin_shift": {
      "description": "Shift notes and authored grid together by +1 s; coordinate-origin invariant.",
      "scoped_families": ["timing", "density", "grammar", "structure"],
      "metrics": ["timing.clean_rate", "timing.absolute_error_p99_ms", "timing.grid_phase_offset_abs_ms", "density_adequacy_score", "density_spike_score", "transition_validity_score", "repetition_adequacy_score", "surface_variety_adequacy_score", "pattern_ic_adequacy_score", "pattern_nll"]
    },
    "CTRL_color_bijection": {
      "description": "Swap Don/Ka while preserving time and size; invariant only for timing and density.",
      "scoped_families": ["timing", "density"],
      "metrics": ["timing.clean_rate", "timing.absolute_error_p99_ms", "timing.grid_phase_offset_abs_ms", "density_adequacy_score", "density_spike_score"]
    },
    "C2_anchor_shift": {
      "description": "Absolute chart translation; negative control only for chart-only families.",
      "scoped_families": ["density", "grammar", "structure"],
      "metrics": ["density_adequacy_score", "density_spike_score", "transition_validity_score", "repetition_adequacy_score", "surface_variety_adequacy_score", "pattern_ic_adequacy_score", "pattern_nll"]
